# Copy this file to .env (same folder) and fill in your keys.
# .env is in .gitignore: never commit it, never paste keys into chat.
# Restart the server after changing it.

# Google AI Studio key: receipt reading, recipe search, fridge photos
GEMINI_API_KEY=

# Neon connection string (Dashboard > Connect). Empty = keep data in memory only.
DATABASE_URL=

# Photon Spectrum project (dashboard > project Settings). Empty = send from this Mac's Messages app.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Neon API key + project ID, for Rewind (Neon Time Travel)
NEON_API_KEY=
NEON_PROJECT_ID=
